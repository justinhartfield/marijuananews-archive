{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marijuananews-archive",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-05",
  "r2_buckets": [
    {
      "binding": "ARCHIVE_ASSETS",
      "bucket_name": "marijuananews-archive-assets"
    }
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "marijuananews.com/*",
      "zone_name": "marijuananews.com"
    },
    {
      "pattern": "www.marijuananews.com/*",
      "zone_name": "marijuananews.com"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BACKEND_USER": "admin"
  }
}
