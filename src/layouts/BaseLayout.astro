---
import globalCss from '../styles/global.css?raw';
import { SITE_DESCRIPTION, SITE_TITLE, absoluteUrl, rewriteAssetUrl, siteMetadata, articles, auditReport } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  canonical = '/',
} = Astro.props;

const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const canonicalUrl = canonical.startsWith('http') ? canonical : absoluteUrl(canonical);
const faviconHref = rewriteAssetUrl(siteMetadata.favicon || '/favicon.svg');
const logoHref = rewriteAssetUrl(siteMetadata.logo || '');
const analyticsId = siteMetadata.google_analytics_id || '';
const schemaJson = siteMetadata.schema ? JSON.stringify(siteMetadata.schema) : '';
const articleCount = Number((auditReport.article_counts as any)?.exported_total || articles.length).toLocaleString();
const privateExcluded = ((auditReport.private_tables_intentionally_excluded as string[]) || []).length;
const buildDate = 'Recovered public archive';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {faviconHref && <link rel="icon" href={faviconHref} />}
    <style is:inline set:html={globalCss}></style>
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {logoHref && <meta property="og:image" content={absoluteUrl(logoHref)} />}
    <meta name="twitter:card" content={logoHref ? 'summary_large_image' : 'summary'} />
    {logoHref && <meta name="twitter:image" content={absoluteUrl(logoHref)} />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS`} href="/rss.xml" />
    {schemaJson && <script type="application/ld+json" set:html={schemaJson}></script>}
    {analyticsId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>}
    {analyticsId && <script is:inline define:vars={{ analyticsId }}>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', analyticsId);</script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="publication-header">
      <div class="archive-strip">
        <div class="container">
          <span>{buildDate}</span>
          <span>{articleCount} public articles · {privateExcluded} private table groups excluded</span>
        </div>
      </div>
      <div class="container masthead-shell">
        <div class="masthead-kicker">Cannabis policy record</div>
        <a class="masthead" href="/" aria-label="Marijuana News home">
          <span class="masthead-title">Marijuana News</span>
          <span class="masthead-subtitle">Independent reform paper archive</span>
        </a>
        <div class="masthead-date">Public source edition</div>
      </div>
      <div class="nav-bar">
        <nav class="container site-nav" aria-label="Primary navigation">
          <a href="/archive/">Archive</a>
          <a href="/articles/">Articles</a>
          <a href="/search/">Search</a>
          <a href="/topics/">Topics</a>
          <a href="/categories/">Categories</a>
          <a href="/faq/">FAQ</a>
          <a href="/bio/">Bio</a>
          <a href="/memory-hole/">Memory hole</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <p><strong>MarijuanaNews.com Archive</strong> preserves the public reading record. Private auth, admin, newsletter, and user tables are not part of this static edition.</p>
        <p><a href="/sitemap.xml">Sitemap</a> · <a href="/rss.xml">RSS</a> · <a href="/search/">Search</a> · <a href="/articles/">Articles</a></p>
      </div>
    </footer>
  </body>
</html>
