---
import globalCss from '../styles/global.css?raw';
import { SITE_DESCRIPTION, SITE_TITLE, absoluteUrl, rewriteAssetUrl, siteMetadata, articles, auditReport } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  canonical = '/',
} = Astro.props;

const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const canonicalUrl = canonical.startsWith('http') ? canonical : absoluteUrl(canonical);
const faviconHref = rewriteAssetUrl(siteMetadata.favicon || '/favicon.svg');
const logoHref = rewriteAssetUrl(siteMetadata.logo || '');
const analyticsId = siteMetadata.google_analytics_id || '';
const schemaJson = siteMetadata.schema ? JSON.stringify(siteMetadata.schema) : '';
const articleCount = Number((auditReport.article_counts as any)?.exported_total || articles.length).toLocaleString();
const navItems = [
  ['Latest', '/articles/'],
  ['Archive', '/archive/'],
  ['Topics', '/topics/'],
  ['FAQ', '/faq/'],
  ['Richard Cowan', '/bio/'],
  ['RSS', '/rss.xml'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {faviconHref && <link rel="icon" href={faviconHref} />}
    <style is:inline set:html={globalCss}></style>
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {logoHref && <meta property="og:image" content={absoluteUrl(logoHref)} />}
    <meta name="twitter:card" content={logoHref ? 'summary_large_image' : 'summary'} />
    {logoHref && <meta name="twitter:image" content={absoluteUrl(logoHref)} />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS`} href="/rss.xml" />
    {schemaJson && <script type="application/ld+json" set:html={schemaJson}></script>}
    {analyticsId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>}
    {analyticsId && <script is:inline define:vars={{ analyticsId }}>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', analyticsId);</script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="publication-header">
      <div class="topbar">
        <div class="container topbar-inner">
          <a class="brand-lockup" href="/" aria-label="Marijuana News home">
            {logoHref ? <img src={logoHref} alt="Marijuana News" decoding="async" /> : <span>Marijuana News</span>}
          </a>
          <form class="header-search" action="/search/" method="get" role="search">
            <label class="sr-only" for="header-q">Search Marijuana News</label>
            <input id="header-q" name="q" type="search" placeholder="Search for news, topics, or sources…" autocomplete="off" />
            <button type="submit">Search</button>
          </form>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">☾</button>
          <a class="signin-link" href="/backend/" rel="nofollow">↪ Sign In</a>
        </div>
        <nav class="container site-nav" aria-label="Primary navigation">
          {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav>
      </div>
      <div class="quote-strip">
        <div class="container">“The best two word explanation for Marijuana Prohibition is Bad Journalism.”</div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-copy">
          <p class="footer-tagline">Freedom has nothing to fear from the truth.</p>
          <p><strong>Marijuana News</strong> is live daily cannabis reporting by <strong>Richard Cowan</strong>, revived from the independent MarijuanaNews.com project launched in 1996. The public library now contains <strong>{articleCount}</strong> searchable articles.</p>
        </div>
        <p class="footer-links"><a href="/sitemap.xml">Sitemap</a> · <a href="/rss.xml">RSS</a> · <a href="/search/">Search</a> · <a href="/articles/">Articles</a></p>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const button = document.querySelector('[data-theme-toggle]');
        const root = document.documentElement;
        const key = 'marijuananews-theme';
        const setTheme = (theme) => {
          root.dataset.theme = theme;
          if (button) button.textContent = theme === 'dark' ? '☀' : '☾';
        };
        try {
          setTheme(localStorage.getItem(key) || 'light');
          button?.addEventListener('click', () => {
            const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
            localStorage.setItem(key, next);
            setTheme(next);
          });
        } catch (_error) {
          setTheme('light');
        }
      })();
    </script>
  </body>
</html>
