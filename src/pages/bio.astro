---
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles, auditReport, bioProfile, displayAssetUrl, rewriteLegacyHtml, SOURCE_SITE_TITLE } from '../lib/content';
const sourceCounts = new Map<string, number>();
for (const article of articles) {
  const source = (article.source || '').trim();
  if (source) sourceCounts.set(source, (sourceCounts.get(source) || 0) + 1);
}
const topSources = Array.from(sourceCounts.entries()).sort((a, b) => b[1] - a[1]).slice(0, 8);
const privateTables = (auditReport.private_tables_intentionally_excluded as string[]) || [];
const bioHtml = bioProfile.content_html_sanitized ? rewriteLegacyHtml(bioProfile.content_html_sanitized) : '';
const bioImageRecord = (bioProfile.image_urls || []).find((image: any) => typeof image?.url === 'string');
const bioImage = displayAssetUrl((bioImageRecord as any)?.url || '');
const bioName = bioProfile.name || 'Richard Cowan';
const bioRole = bioProfile.role || 'Publisher';
---
<BaseLayout title="Bio and archive note" description="Source and provenance note for the rebuilt MarijuanaNews.com archive." canonical="/bio/">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Bio and provenance</p>
      <h1>The paper, the editor, the boundary.</h1>
      <p class="lede">This page explains the recovered public source material. It is a curator and provenance note, not an admin dashboard or recreation of the old private app.</p>
    </div>
  </section>
  <section class="section">
    <div class="container article-shell">
      <article class="legacy-content">
        <h2>{bioName}</h2>
        {bioImage && <img class="bio-image" src={bioImage} alt="" loading="lazy" decoding="async" />}
        <p><strong>{bioName}</strong>{bioRole && <span> is listed by the live public {SOURCE_SITE_TITLE} bio endpoint as <strong>{bioRole}</strong>.</span>}</p>
        {bioHtml ? <div set:html={bioHtml}></div> : <p>Recovered article metadata repeatedly identifies <strong>Richard Cowan</strong> as a former <strong>NORML National Director</strong>, and many records preserve source attribution and original source URLs when those fields existed in the dump.</p>}
        <h2>Migration boundary</h2>
        <p>The static site renders only sanitized public content. The exporter stripped scripts, unsafe URLs, event handlers, iframes, inline styling cruft, and other active legacy markup before Astro receives the HTML.</p>
        <p>Private, auth, newsletter, user, and admin tables were intentionally excluded from the public build.</p>
      </article>
      <aside class="sidebar">
        <section class="clipping-record"><h2>Archive sources</h2><dl>{topSources.map(([name, count]) => <div><dt>{count} articles</dt><dd>{name}</dd></div>)}</dl></section>
        <section class="card"><h2>Excluded private tables</h2><div class="topic-chip-list">{privateTables.map((name) => <span class="pill">{name}</span>)}</div></section>
      </aside>
    </div>
  </section>
</BaseLayout>
