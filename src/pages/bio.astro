---
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles, auditReport, bioProfile, displayAssetUrl, rewriteLegacyHtml, SOURCE_SITE_TITLE } from '../lib/content';
const sourceCounts = new Map<string, number>();
for (const article of articles) {
  const source = (article.source || '').trim();
  if (source) sourceCounts.set(source, (sourceCounts.get(source) || 0) + 1);
}
const topSources = Array.from(sourceCounts.entries()).sort((a, b) => b[1] - a[1]).slice(0, 8);
const privateTables = (auditReport.private_tables_intentionally_excluded as string[]) || [];
const bioHtml = bioProfile.content_html_sanitized ? rewriteLegacyHtml(bioProfile.content_html_sanitized) : '';
const bioImageRecord = (bioProfile.image_urls || []).find((image: any) => typeof image?.url === 'string');
const bioImage = displayAssetUrl((bioImageRecord as any)?.url || '');
const bioName = bioProfile.name || 'Richard Cowan';
const bioRole = bioProfile.role || 'Publisher';
---
<BaseLayout title="Richard Cowan" description="Richard Cowan publishes the revived Marijuana News daily cannabis news site." canonical="/bio/">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Publisher and editor</p>
      <h1>Richard Cowan and Marijuana News.</h1>
      <p class="lede">Richard Cowan is publishing Marijuana News again as a live daily cannabis news site, revived from the independent MarijuanaNews.com project he launched in 1996.</p>
    </div>
  </section>
  <section class="section">
    <div class="container article-shell">
      <article class="legacy-content">
        <h2>{bioName}</h2>
        {bioImage && <img class="bio-image" src={bioImage} alt="" loading="lazy" decoding="async" />}
        <p><strong>{bioName}</strong>{bioRole && <span> is listed by the live public {SOURCE_SITE_TITLE} bio endpoint as <strong>{bioRole}</strong>.</span>} He founded the original MarijuanaNews.com in 1996 and is now publishing it again for today's cannabis policy fight.</p>
        {bioHtml ? <div set:html={bioHtml}></div> : <p>Article metadata repeatedly identifies <strong>Richard Cowan</strong> as a former <strong>NORML National Director</strong>, and many records include source attribution and original source URLs when those fields existed.</p>}
        <h2>Publication boundary</h2>
        <p>The site renders sanitized public articles, FAQ notes, topics, categories, and source metadata. Scripts, unsafe URLs, event handlers, iframes, inline styling cruft, and other active old-site markup are stripped before publication.</p>
        <p>Private, auth, newsletter, user, and admin tables are not part of the public site.</p>
      </article>
      <aside class="sidebar">
        <section class="clipping-record"><h2>Reporting sources</h2><dl>{topSources.map(([name, count]) => <div><dt>{count} articles</dt><dd>{name}</dd></div>)}</dl></section>
        <section class="card"><h2>Excluded private tables</h2><div class="topic-chip-list">{privateTables.map((name) => <span class="pill">{name}</span>)}</div></section>
      </aside>
    </div>
  </section>
</BaseLayout>
