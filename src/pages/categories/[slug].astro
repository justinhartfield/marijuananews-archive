---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleCategorySlug, articleUrl, articles, categories, excerpt, formatDate } from '../../lib/content';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const matches = articles.filter((article) => articleCategorySlug(article) === category.slug);
---
<BaseLayout title={category.name} description={`Recovered MarijuanaNews.com articles in ${category.name}.`} canonical={`/categories/${category.slug}/`}>
  <section class="hero"><div class="container"><p class="eyebrow">Category</p><h1>{category.name}</h1><p class="lede">{matches.length} recovered articles.</p></div></section>
  <section class="section"><div class="container grid three">
    {matches.map((article) => <article class="card"><p class="meta">{formatDate(article.publication_date)}</p><h3><a href={articleUrl(article)}>{article.title}</a></h3><p>{excerpt(article)}</p></article>)}
  </div></section>
</BaseLayout>
