---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../lib/content';
---
<BaseLayout title="Categories" description="Browse Marijuana News cannabis coverage by category." canonical="/categories/">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Category desk</p>
      <h1>Coverage by category.</h1>
      <p class="lede">Marijuana News categories organize current coverage and the older back file into practical desks for policy, medical marijuana, courts, culture, and reform research.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid three">
      {categories.map((category) => <article class="card"><p class="meta">{category.count} articles</p><h3><a href={`/categories/${category.slug}/`}>{category.name}</a></h3></article>)}
    </div>
  </section>
</BaseLayout>
