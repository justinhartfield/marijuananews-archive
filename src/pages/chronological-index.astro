---
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles, articleUrl, excerpt, formatDate } from '../lib/content';

const byYear = new Map<string, typeof articles>();
for (const article of articles) {
  const raw = article.publication_date || article.updated_at || article.created_at || '';
  const date = new Date(raw);
  const year = Number.isNaN(date.getTime()) ? 'Undated' : String(date.getUTCFullYear());
  if (!byYear.has(year)) byYear.set(year, [] as typeof articles);
  byYear.get(year)?.push(article);
}
const years = Array.from(byYear.keys()).sort((a, b) => {
  if (a === 'Undated') return 1;
  if (b === 'Undated') return -1;
  return Number(b) - Number(a);
});
---
<BaseLayout title="Chronological Index" description="Recovered MarijuanaNews.com articles grouped by year from the legacy chronological index route." canonical="/chronological-index/">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Legacy route restored</p>
      <h1>Chronological index.</h1>
      <p class="lede">A year by year path through the public corpus. Dates come from migrated publication, update, and creation timestamps.</p>
      <div class="front-lead-actions"><a class="button" href="/search/">Search the archive</a><a class="button secondary" href="/archive/">Archive pages</a></div>
    </div>
  </section>
  <section class="section">
    <div class="container chronology">
      {years.map((year) => {
        const matches = byYear.get(year) || [];
        return (
          <section class="year-block" id={`year-${year}`}>
            <div class="section-header"><h2>{year}</h2><span class="meta">{matches.length} articles</span></div>
            <div class="article-list">
              {matches.slice(0, 24).map((article) => (
                <article class="article-row">
                  <div class="meta-rail">{formatDate(article.publication_date || article.updated_at || article.created_at)}<br />{article.category || 'General'}</div>
                  <div><h3><a href={articleUrl(article)}>{article.title}</a></h3><p>{excerpt(article, 170)}</p></div>
                </article>
              ))}
            </div>
            {matches.length > 24 && <p><a href={`/search/?year=${encodeURIComponent(year)}`}>View all {matches.length} articles from {year}</a></p>}
          </section>
        );
      })}
    </div>
  </section>
</BaseLayout>
