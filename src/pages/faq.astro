---
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqs, rewriteLegacyHtml, stripHtml, clampText, absoluteUrl } from '../lib/content';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.slice(0, 50).map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: clampText(stripHtml(faq.content_html_sanitized || ''), 600),
    },
  })),
};
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: absoluteUrl('/faq/') },
  ],
};
---
<BaseLayout title="FAQ" description="Marijuana News FAQ and reader notes from the live publication." canonical="/faq/" schema={[faqSchema, breadcrumbSchema]}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">FAQ and reader notes</p>
      <h1>Answers from the publication.</h1>
      <p class="lede">FAQ entries are rendered from sanitized public content. Scripts, unsafe URLs, event handlers, and active old-site markup are stripped before publication.</p>
    </div>
  </section>
  <section class="section">
    <div class="container article-list">
      {faqs.map((faq) => <article class="article-row"><div class="meta-rail">FAQ #{faq.id}<br />{faq.category || 'Reader note'}</div><div><h2>{faq.question}</h2><div class="legacy-content" set:html={rewriteLegacyHtml(faq.content_html_sanitized)}></div></div></article>)}
    </div>
  </section>
</BaseLayout>
