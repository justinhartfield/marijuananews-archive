---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles, articleTopicSlug, articleUrl, excerpt, formatDate, topics } from '../../lib/content';

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const matches = articles.filter((article) => articleTopicSlug(article) === topic.slug);
---
<BaseLayout title={topic.name} description={topic.description || `Marijuana News articles about ${topic.name}.`} canonical={`/topics/${topic.slug}/`}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Topic desk</p>
      <h1>{topic.name}</h1>
      <p class="lede">{topic.description || `${matches.length} Marijuana News articles filed under this subject.`}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {matches.length === 0 ? <p class="empty-note">No articles are filed under this topic yet.</p> : <div class="article-list">
        {matches.map((article) => <article class="article-row"><div class="meta-rail">{formatDate(article.publication_date)}<br />{article.category || 'General'}</div><div><h2><a href={articleUrl(article)}>{article.title}</a></h2><p>{excerpt(article, 220)}</p></div></article>)}
      </div>}
    </div>
  </section>
</BaseLayout>
