---
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles, categories, topics, faqs, redirects, auditReport, articleUrl, articleImageUrl, articleCategorySlug, excerpt, formatDate, SITE_DESCRIPTION, SITE_TITLE } from '../lib/content';

const featured = articles.find((article) => articleImageUrl(article)) || articles[0];
const featuredImage = featured ? articleImageUrl(featured) : '';
const latest = articles.filter((article) => article.slug !== featured?.slug).slice(0, 10);
const exportedTotal = Number((auditReport.article_counts as any)?.exported_total || articles.length).toLocaleString();
const assetTotal = Number((auditReport.assets as any)?.total_unique_asset_urls || 0).toLocaleString();
const redirectTotal = redirects.length.toLocaleString();
const firstLatest = latest.slice(0, 5);
const secondLatest = latest.slice(5, 10);
---
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} canonical="/">
  <section class="hero">
    <div class="container front-page-layout">
      <div class="front-lead">
        <p class="eyebrow">Live cannabis news</p>
        <h1>Daily cannabis news, revived by Richard Cowan.</h1>
        <p class="lede">Marijuana News is publishing again: current cannabis policy, medical marijuana, research, prohibition, courts, culture, and industry coverage from the independent voice Richard Cowan launched online in 1996.</p>
        <div class="front-lead-actions">
          <a class="button" href="/articles/">Read latest articles</a>
          <a class="button secondary" href="/search/">Search the reporting</a>
        </div>
      </div>
      <aside class="archive-stat-box" aria-label="Publication ledger">
        <p class="eyebrow">Publication ledger</p>
        <dl>
          <div><dt>Articles</dt><dd>{exportedTotal}</dd></div>
          <div><dt>Topics</dt><dd>{topics.length}</dd></div>
          <div><dt>FAQs</dt><dd>{faqs.length}</dd></div>
          <div><dt>Assets</dt><dd>{assetTotal}</dd></div>
          <div><dt>Redirects</dt><dd>{redirectTotal}</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container front-page-layout">
      <article class="featured-story">
        <div>
          <p class="eyebrow">Lead story</p>
          <h2><a href={articleUrl(featured)}>{featured.title}</a></h2>
          <p class="meta">{formatDate(featured.publication_date)}{featured.category && <> · <a href={`/categories/${articleCategorySlug(featured)}/`}>{featured.category}</a></>}{featured.source && <> · {featured.source}</>}</p>
          <p>{excerpt(featured, 280)}</p>
          <p><a class="button" href={articleUrl(featured)}>Read article</a></p>
        </div>
        {featuredImage && <img class="featured-image" src={featuredImage} alt="" loading="eager" decoding="async" />}
      </article>
      <aside class="public-notice">
        <p class="eyebrow">Live revival</p>
        <p><strong>Marijuana News is active again.</strong> Richard Cowan is publishing new cannabis reporting on top of the older MarijuanaNews.com record, so readers can follow today's drug war, medical marijuana, legalization, and research stories in the same long-running editorial line.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Latest articles</h2>
        <a href="/archive/">All articles</a>
      </div>
      <div class="grid two">
        <div class="article-list">
          {firstLatest.map((article) => (
            <article class="article-row">
              <div class="meta-rail">{formatDate(article.publication_date)}<br />{article.category || 'General'}</div>
              <div>
                <h3><a href={articleUrl(article)}>{article.title}</a></h3>
                <p>{excerpt(article, 185)}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="article-list">
          {secondLatest.map((article) => (
            <article class="article-row">
              <div class="meta-rail">{formatDate(article.publication_date)}<br />{article.category || 'General'}</div>
              <div>
                <h3><a href={articleUrl(article)}>{article.title}</a></h3>
                <p>{excerpt(article, 185)}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid two">
      <div>
        <div class="section-header"><h2>Issue categories</h2><a href="/categories/">All categories</a></div>
        <div class="topic-chip-list">
          {categories.slice(0, 14).map((category) => <a href={`/categories/${category.slug}/`}><strong>{category.name}</strong>&nbsp;{category.count}</a>)}
        </div>
      </div>
      <div>
        <div class="section-header"><h2>Topic desk</h2><a href="/topics/">All topics</a></div>
        <div class="topic-chip-list">
          {topics.slice(0, 14).map((topic) => <a href={`/topics/${topic.slug}/`}>{topic.name}</a>)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
