---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  articles,
  faqs,
  redirects,
  auditReport,
  articleUrl,
  articleImageUrl,
  articleCategorySlug,
  articleTopicSlug,
  excerpt,
  formatDate,
  slugify,
  SITE_DESCRIPTION,
  SITE_TITLE,
} from '../lib/content';

const featured = articles.find((article) => article.is_featured) || articles[0];
const latest = articles.slice(0, 7);
const articleTotal = Number((auditReport.article_counts as any)?.exported_total || articles.length).toLocaleString();
const redirectTotal = redirects.length.toLocaleString();
const faqTotal = faqs.length.toLocaleString();
const logoPath = '/mj_logo.png';
const richardPortrait = '/assets/richard-cowan-portrait.jpg';

const topicMap = new Map<string, { name: string; slug: string; count: number }>();
for (const article of articles) {
  const name = article.topic?.name || article.category || 'General News';
  const slug = articleTopicSlug(article) || slugify(name);
  const existing = topicMap.get(slug) || { name, slug, count: 0 };
  existing.count += 1;
  topicMap.set(slug, existing);
}
const topicCloud = Array.from(topicMap.values())
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
  .slice(0, 15);

function readTimeLabel(article: typeof articles[number]): string {
  const raw = Number(article.read_time || 0);
  if (!Number.isFinite(raw) || raw <= 0) return '4 min';
  return `${Math.max(1, Math.round(raw))} min`;
}

function relativeAgeLabel(raw?: string | null): string {
  const time = Date.parse(raw || '');
  if (!Number.isFinite(time)) return 'undated';
  const days = Math.max(0, Math.round((Date.now() - time) / 86400000));
  if (days < 2) return 'today';
  if (days < 31) return `${days} days ago`;
  if (days < 366) {
    const months = Math.max(1, Math.round(days / 30));
    return `${months} month${months === 1 ? '' : 's'} ago`;
  }
  const years = Math.max(1, Math.round(days / 365));
  return `${years} year${years === 1 ? '' : 's'} ago`;
}

function storyTopic(article: typeof articles[number]) {
  const name = article.topic?.name || article.category || 'General News';
  const slug = articleTopicSlug(article) || articleCategorySlug(article);
  return { name, slug };
}
---
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} canonical="/">
  <section class="home-wrap">
    <div class="container home-grid">
      <div class="home-main">
        <article class="featured-card">
          <div class="featured-copy">
            <div class="featured-meta">
              <span>▣ Richard Cowan</span>
              <span>▣ {formatDate(featured.publication_date)}</span>
            </div>
            <span class="featured-badge">Featured</span>
            <h1><a href={articleUrl(featured)}>{featured.title}</a></h1>
            <p>{excerpt(featured, 210)}</p>
            <a class="button light" href={articleUrl(featured)}>Read Full Article →</a>
          </div>
          <div class="featured-mark" aria-hidden="true">
            <img src={logoPath} alt="" decoding="async" />
          </div>
        </article>

        <section class="article-stream" aria-labelledby="articles-heading">
          <div class="section-header clean">
            <h2 id="articles-heading">Articles</h2>
            <a href="/archive/">View full archive</a>
          </div>
          <div class="story-list">
            {latest.map((article) => {
              const image = articleImageUrl(article);
              const topic = storyTopic(article);
              return (
                <article class="story-card">
                  {image && <a class="story-thumb" href={articleUrl(article)} aria-label={`Read ${article.title}`}><img src={image} alt="" loading="lazy" decoding="async" /></a>}
                  <div class="story-body">
                    <div class="story-meta">
                      <span>Richard Cowan</span>
                      <span>● {readTimeLabel(article)}</span>
                      <span class="story-age">▣ {relativeAgeLabel(article.publication_date)}</span>
                    </div>
                    <h3><a href={articleUrl(article)}>{article.title}</a></h3>
                    <p>{excerpt(article, 150)}</p>
                    <div class="story-footer">
                      <a class="topic-pill" href={`/topics/${topic.slug}/`}>{topic.name}</a>
                      <div class="story-actions" aria-label="Story actions">
                        <span title="Save">♡</span>
                        <span title="Copy link">↗</span>
                        <span title="Share">f</span>
                        <span title="Share on X">𝕏</span>
                        <span title="Share on LinkedIn">in</span>
                      </div>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      </div>

      <aside class="home-sidebar" aria-label="Marijuana News sidebar">
        <section class="sidebar-card author-card">
          <img src={richardPortrait} alt="Richard Cowan" loading="eager" decoding="async" />
          <div>
            <h2>Richard Cowan</h2>
            <a href="/bio/">View Bio →</a>
          </div>
        </section>

        <section class="sidebar-card cta-card">
          <h2>Chronological Index</h2>
          <p>Explore the complete Marijuana News index, from the latest updates to articles dating back to 1997.</p>
          <a class="outline-button" href="/chronological-index/">View full archive</a>
        </section>

        <section class="sidebar-card topics-card">
          <h2>Topics</h2>
          <div class="tag-cloud">
            {topicCloud.map((topic) => <a href={`/topics/${topic.slug}/`}>{topic.name} <span>({topic.count})</span></a>)}
          </div>
        </section>

        <section class="sidebar-card cta-card">
          <h2>Frequently Asked Questions</h2>
          <p>Find answers to common questions about marijuana legalization, medical research, policy changes, and industry developments.</p>
          <a class="outline-button" href="/faq/">Browse FAQ Section</a>
        </section>

        <section class="sidebar-card newsletter-card">
          <h2>Subscribe to Newsletter!</h2>
          <p>Join readers getting cannabis policy, research, media criticism, and industry updates.</p>
          <form class="newsletter-form" action="/api/newsletter" method="post" data-newsletter-form>
            <label class="sr-only" for="newsletter-email">Your email address</label>
            <input id="newsletter-email" name="email" type="email" placeholder="Your email address" autocomplete="email" required />
            <button type="submit">Subscribe</button>
            <p class="newsletter-status" data-newsletter-status>Weekly dispatch. No spam.</p>
          </form>
        </section>

        <section class="sidebar-card stats-card" aria-label="Library stats">
          <div><strong>{articleTotal}</strong><span>articles</span></div>
          <div><strong>{topicCloud.length}</strong><span>active topics</span></div>
          <div><strong>{faqTotal}</strong><span>FAQs</span></div>
          <div><strong>{redirectTotal}</strong><span>legacy redirects</span></div>
        </section>
      </aside>
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.querySelector('[data-newsletter-form]');
      if (!form) return;
      const status = form.querySelector('[data-newsletter-status]');
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const email = new FormData(form).get('email');
        if (status) status.textContent = 'Subscribing…';
        try {
          const response = await fetch('/api/newsletter', {
            method: 'POST',
            headers: { 'content-type': 'application/json', accept: 'application/json' },
            body: JSON.stringify({ email, source: 'homepage' })
          });
          const data = await response.json();
          if (!response.ok || !data.ok) throw new Error(data.error || 'Newsletter signup failed.');
          form.reset();
          if (status) status.textContent = 'Subscribed. Check your inbox when the first dispatch goes out.';
        } catch (error) {
          if (status) status.textContent = error.message || 'Signup failed. Try again later.';
        }
      });
    })();
  </script>
</BaseLayout>
