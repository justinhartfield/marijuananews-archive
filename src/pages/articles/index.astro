---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { archivePageCount, articleUrl, excerpt, formatDate, getArticlesPage } from '../../lib/content';

const page = 1;
const pageArticles = getArticlesPage(page);
---
<BaseLayout title="Articles" description="Browse the recovered MarijuanaNews.com article archive from the legacy articles route." canonical="/articles/">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Legacy route restored</p>
      <h1>Articles in public order.</h1>
      <p class="lede">The old articles route now opens into the recovered paper. Dates, categories, and excerpts are kept close to each headline so long legacy titles remain scannable.</p>
      <div class="front-lead-actions">
        <a class="button" href="/search/">Search articles</a>
        <a class="button secondary" href="/archive/">Paginated archive</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container article-list">
      {pageArticles.map((article) => (
        <article class="article-row">
          <div class="meta-rail">{formatDate(article.publication_date)}<br />{article.category || 'General'}</div>
          <div>
            <h2><a href={articleUrl(article)}>{article.title}</a></h2>
            <p>{excerpt(article, 220)}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="container pagination">
      <span>Page {page} of {archivePageCount}</span>
      {archivePageCount > 1 && <a class="button" href="/archive/2/">Older articles</a>}
    </div>
  </section>
</BaseLayout>
