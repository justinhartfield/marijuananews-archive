---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles, articleUrl, articleCategorySlug, articleImageUrl, articleTopicSlug, excerpt, formatDate, getRelatedArticles, keywords, rewriteLegacyHtml } from '../../lib/content';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const html = rewriteLegacyHtml(article.content_html_sanitized || '');
const cover = articleImageUrl(article);
const related = getRelatedArticles(article, 5);
const title = article.meta_title || article.title;
const description = article.meta_description || excerpt(article, 165);
const canonical = articleUrl(article);
const topicSlug = articleTopicSlug(article);
const categorySlug = articleCategorySlug(article);
const tags = keywords(article);
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <header class="article-header">
    <div class="container">
      <p class="eyebrow">Recovered article</p>
      <h1>{article.title}</h1>
      <p class="lede">{description}</p>
      <div class="pill-row">
        <span class="pill">{formatDate(article.publication_date)}</span>
        {article.category && <a class="pill" href={`/categories/${categorySlug}/`}>{article.category}</a>}
        {article.topic?.name && topicSlug && <a class="pill" href={`/topics/${topicSlug}/`}>{article.topic.name}</a>}
        {article.source && <span class="pill">Source: {article.source}</span>}
      </div>
      {cover && <img class="article-cover" src={cover} alt="" loading="eager" decoding="async" />}
    </div>
  </header>

  <div class="container article-shell">
    <article class="legacy-content" set:html={html}></article>
    <aside class="sidebar">
      <div class="card">
        <h2>Article data</h2>
        <ul class="list">
          <li><strong>Date:</strong> {formatDate(article.publication_date)}</li>
          {article.source && <li><strong>Source:</strong> {article.source}</li>}
          {article.live_status && <li><strong>Live status:</strong> {article.live_status}</li>}
          {article.topic_id && <li><strong>Live topic ID:</strong> {article.topic_id}</li>}
          {typeof article.likes_count === 'number' && <li><strong>Live likes:</strong> {article.likes_count}</li>}
          {article.source_url && <li><a href={article.source_url} rel="noopener noreferrer nofollow">Original/source URL</a></li>}
          <li><strong>Archive path:</strong><br /><code>{canonical}</code></li>
        </ul>
      </div>
      {tags.length > 0 && <div class="card">
        <h2>Keywords</h2>
        <div class="pill-row">{tags.map((tag) => <span class="pill">{tag}</span>)}</div>
      </div>}
      {related.length > 0 && <div class="card">
        <h2>Related</h2>
        <ul class="list">
          {related.map((item) => <li><a href={articleUrl(item)}>{item.title}</a><br /><span class="meta">{formatDate(item.publication_date)}</span></li>)}
        </ul>
      </div>}
    </aside>
  </div>
</BaseLayout>
