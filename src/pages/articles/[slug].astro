---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE, absoluteUrl, articles, articleUrl, articleCategorySlug, articleImageUrl, articleTopicSlug, excerpt, formatDate, getRelatedArticles, keywords, rewriteLegacyHtml } from '../../lib/content';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const html = rewriteLegacyHtml(article.content_html_sanitized || '');
const cover = articleImageUrl(article);
const related = getRelatedArticles(article, 5);
const title = article.meta_title || article.title;
const description = article.meta_description || excerpt(article, 165);
const canonical = articleUrl(article);
const topicSlug = articleTopicSlug(article);
const categorySlug = articleCategorySlug(article);
const tags = keywords(article);
const articleSchema = {
  '@type': 'NewsArticle',
  headline: article.title,
  description,
  url: absoluteUrl(canonical),
  mainEntityOfPage: absoluteUrl(canonical),
  datePublished: article.publication_date || article.created_at || undefined,
  dateModified: article.updated_at || article.publication_date || article.created_at || undefined,
  author: { '@type': 'Person', name: 'Richard Cowan', url: absoluteUrl('/bio/') },
  publisher: {
    '@type': 'NewsMediaOrganization',
    name: SITE_TITLE,
    url: absoluteUrl('/'),
    logo: { '@type': 'ImageObject', url: absoluteUrl('/mj_logo.png') },
  },
  articleSection: article.category || article.topic?.name || undefined,
  keywords: tags.length ? tags.join(', ') : undefined,
  image: cover ? [absoluteUrl(cover)] : undefined,
  isAccessibleForFree: true,
};
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: absoluteUrl('/articles/') },
    { '@type': 'ListItem', position: 3, name: article.title, item: absoluteUrl(canonical) },
  ],
};
---
<BaseLayout title={title} description={description} canonical={canonical} image={cover} type="article" schema={[articleSchema, breadcrumbSchema]}>
  <header class="article-header">
    <div class="container">
      <p class="eyebrow">Marijuana News article</p>
      <h1>{article.title}</h1>
      <p class="meta">{formatDate(article.publication_date)}{article.category && <> · <a href={`/categories/${categorySlug}/`}>{article.category}</a></>}{article.topic?.name && topicSlug && <> · <a href={`/topics/${topicSlug}/`}>{article.topic.name}</a></>}{article.source && <> · {article.source}</>}</p>
      <p class="lede">{description}</p>
      {cover && <img class="article-cover" src={cover} alt={article.title} loading="eager" decoding="async" />}
    </div>
  </header>

  <div class="container article-shell">
    <article class="legacy-content" set:html={html}></article>
    <aside class="sidebar" aria-label="Article details">
      <section class="clipping-record">
        <h2>Article record</h2>
        <dl>
          <div><dt>Date</dt><dd>{formatDate(article.publication_date)}</dd></div>
          {article.category && <div><dt>Category</dt><dd><a href={`/categories/${categorySlug}/`}>{article.category}</a></dd></div>}
          {article.topic?.name && topicSlug && <div><dt>Topic</dt><dd><a href={`/topics/${topicSlug}/`}>{article.topic.name}</a></dd></div>}
          {article.source && <div><dt>Source</dt><dd>{article.source}</dd></div>}
          {article.source_url && <div><dt>Source URL</dt><dd><a href={article.source_url} rel="noopener noreferrer nofollow">Original source</a></dd></div>}
          <div><dt>Article path</dt><dd><code>{canonical}</code></dd></div>
        </dl>
      </section>
      {tags.length > 0 && <section class="card">
        <h2>Keywords</h2>
        <div class="topic-chip-list">{tags.map((tag) => <span class="pill">{tag}</span>)}</div>
      </section>}
      {related.length > 0 && <section class="card">
        <h2>Related articles</h2>
        <ul class="list">
          {related.map((item) => <li><a href={articleUrl(item)}>{item.title}</a><br /><span class="meta">{formatDate(item.publication_date)}</span></li>)}
        </ul>
      </section>}
    </aside>
  </div>
</BaseLayout>
